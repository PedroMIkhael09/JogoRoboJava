<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.controller.Main3Controller">
    <top>
        <VBox spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0; -fx-padding: 20;">
            <children>
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="ROBÔ NORMAL vs ROBÔ INTELIGENTE" textAlignment="CENTER">
                    <font>
                        <Font name="Consolas" size="20.0" />
                    </font>
                    <style>
                        -fx-text-fill: #212529;
                        -fx-font-weight: bold;
                    </style>
                </Label>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Label text="ROBÔ NORMAL:" textFill="#6c757d">
                            <font>
                                <Font name="Consolas" size="12.0" />
                            </font>
                        </Label>
                        <ColorPicker fx:id="colorPicker1" prefWidth="80.0" style="-fx-background-color: white; -fx-border-color: #6c757d; -fx-border-width: 1; -fx-border-radius: 4;" />

                        <Label text="ROBÔ INTELIGENTE:" textFill="#6c757d">
                            <font>
                                <Font name="Consolas" size="12.0" />
                            </font>
                        </Label>
                        <ColorPicker fx:id="colorPicker2" prefWidth="80.0" style="-fx-background-color: white; -fx-border-color: #6c757d; -fx-border-width: 1; -fx-border-radius: 4;" />

                        <Button fx:id="iniciarButton" mnemonicParsing="false" onAction="#iniciarJogo" prefWidth="100.0" style="-fx-background-color: #495057; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4;" text="INICIAR">
                            <font>
                                <Font name="Consolas" size="11.0" />
                            </font>
                        </Button>
                        <Button fx:id="resetButton" disable="true" mnemonicParsing="false" onAction="#resetarJogo" prefWidth="80.0" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4;" text="RESET">
                            <font>
                                <Font name="Consolas" size="11.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <Label fx:id="infoLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font name="Consolas" size="11.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" style="-fx-background-color: #ffffff; -fx-padding: 30;">
            <children>
                <GridPane fx:id="gridPane" alignment="CENTER" hgap="6.0" vgap="6.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </GridPane>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0; -fx-padding: 20;">
            <children>
                <Label fx:id="statusLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12;" text="🤖 Configure os robôs e inicie o jogo" textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font name="Consolas" size="12.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </bottom>
</BorderPane>