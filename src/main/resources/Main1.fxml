<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="main.controller.Main1Controller"
      spacing="10" alignment="CENTER"
      prefWidth="800.0" prefHeight="600.0"
      style="-fx-padding: 10; -fx-background-color: #f5f5f5;">

    <!-- TÍTULO E CONTROLES SUPERIORES -->
    <VBox spacing="8" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5;">
        <Label text="ROBÔ COLETOR DE ENERGIA" style="-fx-font-weight: bold; -fx-text-fill: #333;">
            <font><Font name="System Bold" size="14" /></font>
        </Label>

        <HBox spacing="8" alignment="CENTER">
            <Label text="COR:" style="-fx-text-fill: #555;"/>
            <ColorPicker fx:id="colorPicker" style="-fx-color-label-visible: false; -fx-pref-width: 50;"/>
            <Button fx:id="iniciarButton" text="INICIAR" onAction="#iniciarJogo"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 70; -fx-font-size: 12;"/>
            <Button fx:id="resetButton" text="RESET" onAction="#resetarJogo" disable="true"
                    style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-min-width: 70; -fx-font-size: 12;"/>
        </HBox>

        <HBox spacing="25" alignment="CENTER">
            <Label fx:id="posicaoLabel" text="POSIÇÃO: --" style="-fx-text-fill: #555; -fx-font-size: 12;"/>
            <Label fx:id="movimentosLabel" text="MOVIMENTOS: 0" style="-fx-text-fill: #555; -fx-font-size: 12;"/>
        </HBox>
    </VBox>

    <!-- TABULEIRO CENTRALIZADO -->
    <StackPane alignment="CENTER">
        <GridPane fx:id="gridPane"
                  hgap="3" vgap="3"
                  alignment="CENTER"
                  style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 8;"/>
    </StackPane>

    <!-- CONTROLES INFERIORES -->
    <VBox spacing="8" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5;">
        <Label text="CONTROLES" style="-fx-font-weight: bold; -fx-text-fill: #333; -fx-font-size: 12;"/>

        <GridPane hgap="5" vgap="5" alignment="CENTER">
            <Button text="↑" onAction="#moverUp"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12; -fx-min-width: 45; -fx-min-height: 35;"
                    GridPane.columnIndex="1"/>
            <Button text="←" onAction="#moverLeft"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12; -fx-min-width: 45; -fx-min-height: 35;"
                    GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Button text="→" onAction="#moverRight"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12; -fx-min-width: 45; -fx-min-height: 35;"
                    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Button text="↓" onAction="#moverDown"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 12; -fx-min-width: 45; -fx-min-height: 35;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <HBox spacing="5" alignment="CENTER">
            <Label text="INPUT:" style="-fx-text-fill: #555; -fx-font-size: 12;"/>
            <TextField fx:id="direcaoInput" promptText="up/1, down/2, left/3, right/4"
                       style="-fx-prompt-text-fill: #aaa; -fx-background-radius: 3; -fx-border-color: #ccc; -fx-border-radius: 3; -fx-pref-width: 200; -fx-font-size: 12;"/>
            <Button text="EXEC" onAction="#moverTexto"
                    style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 60; -fx-font-size: 12;"/>
        </HBox>

        <Label text="Use: up/1, down/2, left/3, right/4 (separados por vírgula)" style="-fx-font-size: 10; -fx-text-fill: #777;"/>
        <Label fx:id="statusLabel" text="Configure o robô e inicie o jogo"
               style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-padding: 5; -fx-text-fill: #555; -fx-font-size: 11;"
               wrapText="true" maxWidth="550" alignment="CENTER"/>
    </VBox>
</VBox>