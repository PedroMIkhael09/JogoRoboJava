<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.controller.Main2Controller"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #f8f9fa;">

    <!-- TOP SECTION - Compactada -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15;">
            <Label text="CORRIDA DE ROBÔS" style="-fx-font-weight: bold; -fx-text-fill: #212529;" alignment="CENTER">
                <font><Font name="Consolas" size="18"/></font>
            </Label>

            <HBox alignment="CENTER" spacing="15">
                <!-- Robô 1 -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="ROBÔ 1:" style="-fx-text-fill: #6c757d;">
                        <font><Font name="Consolas" size="11"/></font>
                    </Label>
                    <ColorPicker fx:id="colorPicker1" style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4;"/>
                </HBox>

                <!-- Robô 2 -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="ROBÔ 2:" style="-fx-text-fill: #6c757d;">
                        <font><Font name="Consolas" size="11"/></font>
                    </Label>
                    <ColorPicker fx:id="colorPicker2" style="-fx-background-color: white; -fx-border-color: #ced4da; -fx-border-radius: 4;"/>
                </HBox>

                <!-- Botões -->
                <Button fx:id="iniciarButton" text="INICIAR" onAction="#iniciarJogo"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80;"/>
                <Button fx:id="resetButton" text="RESET" onAction="#resetarJogo" disable="true"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-min-width: 80;"/>
            </HBox>

            <Label fx:id="infoLabel" style="-fx-text-fill: #6c757d;" alignment="CENTER" wrapText="true">
                <font><Font name="Consolas" size="10"/></font>
            </Label>
        </VBox>
    </top>

    <!-- CENTER SECTION - Tabuleiro -->
    <center>
        <StackPane>
            <GridPane fx:id="gridPane" alignment="CENTER" hgap="5" vgap="5"
                      style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-border-radius: 6;">
                <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            </GridPane>
        </StackPane>
    </center>

    <!-- BOTTOM SECTION - Status -->
    <bottom>
        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Label fx:id="statusLabel" alignment="CENTER" maxWidth="600" wrapText="true"
                   style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-radius: 4; -fx-padding: 8; -fx-text-fill: #495057;">
                <font><Font name="Consolas" size="11"/></font>
            </Label>
        </VBox>
    </bottom>
</BorderPane>